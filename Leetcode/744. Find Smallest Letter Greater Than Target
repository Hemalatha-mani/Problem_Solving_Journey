744. Find Smallest Letter Greater Than Target

class Solution {
    public char nextGreatestLetter(char[] letters, char target) {
        int low=0;
        int high=letters.length-1;
        while(low<=high){
            int m=low+(high-low)/2;
            if(letters[m]<=target){
                low=m+1;
            }
            else{
                high=m-1;
            }
        }
        return letters[low%letters.length];
        
        
    }
}
