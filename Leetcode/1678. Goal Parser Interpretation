1678. Goal Parser Interpretation

class Solution {
    public String interpret(String command) {
        String ans="";
        for(int i=0;i<command.length();i++){
            if(command.charAt(i)=='G'){
                ans=ans+command.charAt(i);
            }
            else if(command.charAt(i+1)==')'){
                ans=ans+'o';
                i++;
            }
            else {
                ans=ans+"al";
                i=i+3;
            }
        }
        return ans;
        
        
    }
}
