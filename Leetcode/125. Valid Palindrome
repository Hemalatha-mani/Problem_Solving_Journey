125. Valid Palindrome

class Solution {
    public boolean isPalindrome(String s) {
       String a="";
       for(int i=0;i<s.length();i++){
        char c=s.charAt(i);
        if(Character.isLetter(c) || Character.isDigit(c)){
            a=a+c;
        }
       }
       char[] b=a.toCharArray();
       int l=0;
       int r=a.length()-1;
       while(l<r){
        if(Character.toLowerCase(b[l])==Character.toLowerCase(b[r])){
            l++;
            r--;
        }
        else{
            return false;
        }
       }
       return true;
        
    }
}
