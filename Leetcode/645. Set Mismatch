645. Set Mismatch

class Solution {
    public int[] findErrorNums(int[] nums) {
        int ans[]=new int[2];
        HashMap<Integer,Integer> map=new HashMap<>();
        ArrayList<Integer> a=new ArrayList<>();
        for(int x:nums){
            map.put(x,map.getOrDefault(x,0)+1);
            a.add(x);
            if(map.get(x)>1){
                ans[0]=x;
            }
        }
        int index=0;
        Arrays.sort(nums);
        for(int i=1;i<=nums.length;i++){
            if(!a.contains(i)){
                ans[1]=i;
                //return;

            }
        }
        return ans;
        
    }
}
