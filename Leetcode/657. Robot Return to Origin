657. Robot Return to Origin

class Solution {
    public boolean judgeCircle(String moves) {
        int count=0;
        for(int i=0;i<moves.length();i++){
            if(moves.charAt(i)=='L' || moves.charAt(i)=='U'){
                count++;
            }
            if(moves.charAt(i)=='D' || moves.charAt(i)=='R'){
                count--;
            }
        }
        if(count==0){
            return true;
        }
        return false;
        
    }
}
