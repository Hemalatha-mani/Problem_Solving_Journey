2000. Reverse Prefix of Word

class Solution {
    public String reversePrefix(String word, char ch) {
        int ind=-1;
        char a[]=word.toCharArray();
        for(int i=0;i<word.length();i++){
            if(word.charAt(i)==ch){
                ind=i;
                break;
            }
        }
        int l=0;
        int r=ind;
        while(l<r){
            char temp=a[l];
            a[l]=a[r];
            a[r]=temp;
            l++;
            r--;

        }
        String ans="";
        for(char c:a){
            ans=ans+c;
        }
        return ans;
        
    }
}
