2651. Calculate Delayed Arrival Time

class Solution {
    public int findDelayedArrivalTime(int arrivalTime, int delayedTime) {
        int ans=arrivalTime+delayedTime;
        if(ans==24){
            return 0;
        }
        else if(ans>24){
            return ans-24;
        }
        return ans;
        
    }
}
