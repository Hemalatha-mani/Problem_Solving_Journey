1539. Kth Missing Positive Number

class Solution {
    public int findKthPositive(int[] arr, int k) {
        int num=1;
        int miss=0;
        for(int i=0;i<arr.length;i++){
            while(num<arr[i]){
                miss++;
                if(miss==k){
                    return num;
                }
                num++;

            }
            num++;
        }
        while(true){
            miss++;
            if(miss==k){
                return num;
            }
            num++;
        }
        
    }
}
