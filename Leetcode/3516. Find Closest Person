3516. Find Closest Person

class Solution {
    public int findClosest(int x, int y, int z) {
        int min=Integer.MAX_VALUE;
        int xz=Math.abs(x-z);
        int yz=Math.abs(y-z);
        if(xz<yz){
            return 1;
        }
        else if(yz<xz){
            return 2;
        }
        return 0;
        
    }
}
