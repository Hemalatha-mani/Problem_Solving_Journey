414. Third Maximum Number

class Solution {
    public int thirdMax(int[] nums) {
        int fm=Integer.MIN_VALUE;
        int sm=Integer.MIN_VALUE;
        int tm=Integer.MIN_VALUE;
        
        HashSet<Integer> set=new HashSet<>();
         if(nums.length==1){
            return nums[0];
        }
       
        for(int n:nums){
            set.add(n);
        }
        int max=Integer.MIN_VALUE;
        if(set.size()<3 ){
            
            for(int i:set){
                if(i>max){
                    max=i;
                }
                
            }
            return max;

        }
        else{
            for(int n:nums){
            if(n>fm){
                tm=sm;
                sm=fm;
                fm=n;
            }
            else if(n>sm & n!=fm){
                tm=sm;
                sm=n;
            }
            else if(n>tm & n!=sm &n!=fm){
                tm=n;
            }
        }

        }
        return tm;
        
    }
}
