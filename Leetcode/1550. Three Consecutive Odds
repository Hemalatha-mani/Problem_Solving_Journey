1550. Three Consecutive Odds

class Solution {
    public boolean threeConsecutiveOdds(int[] arr) {
        boolean ans=false;
        int count=0;
        int max=Integer.MIN_VALUE;
        for(int n:arr){
            if(n%2!=0){
                count++;
                max=Math.max(max,count);
            }
            else{
                count=0;

            }
        }
        if(max>=3){
            ans=true;
        }
        return ans;
        
    }
}
