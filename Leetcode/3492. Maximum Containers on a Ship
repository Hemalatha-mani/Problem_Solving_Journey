3492. Maximum Containers on a Ship

class Solution {
    public int maxContainers(int n, int w, int maxWeight) {
        int count=0;
        int deck=n*n;
        for(int i=1;i<=deck;i++){
            if((i*w) >maxWeight){
                return count;

            }
            else{
                count++;
            }

        }
        return count;
        
    }
}
