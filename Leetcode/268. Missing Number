268. Missing Number

class Solution {
    public int missingNumber(int[] nums) {
        int n=nums.length;
        int ans=-1;
        Arrays.sort(nums);
        for(int i=0;i<nums.length;i++){
            if(nums[i]==i){
                continue;
            }
            else{
                ans=i;
                break;

            }
        }
        
        if(ans==-1){
            return n;
        }
        return ans;
    }
}
