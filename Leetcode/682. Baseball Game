682. Baseball Game

class Solution {
    public int calPoints(String[] operations) {
        Stack<Integer> s=new Stack<>();
        for(String a:operations){
            if(a.equals("C")){
                s.pop();
            }
            else if(a.equals("D")){
                int b=2*s.peek();
                s.push(b);

            }
            else if(a.equals("+")){
                int sum=0;
                int f=s.pop();
                int sec=s.peek();
                sum=f+sec;
                s.push(f);
                s.push(sum);

            }
            else{
                s.push(Integer.parseInt(a));
            }
            
        }
        int sum1=0;
        for(int i=0;i<s.size();i++){
                    sum1=sum1+s.get(i);
                }
        return sum1;
    }
}
