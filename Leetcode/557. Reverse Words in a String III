557. Reverse Words in a String III

class Solution {
    public String reverseWords(String s) {
        String a="";
        String b[]=s.split(" ");
        for(int i=0;i<b.length;i++){
            String d="";
            String m=b[i];
            for(int j=m.length()-1;j>=0;j--){
                d=d+m.charAt(j);
            }
            a=a+d;
            if(i!=b.length-1){
                a=a+" ";
            }
        }
        return a;
        
    }
}
