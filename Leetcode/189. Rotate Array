189. Rotate Array

class Solution {
    static void reverse(int a[],int l,int r){
            while(l<r){
                int t=a[r];
                a[r]=a[l];
                a[l]=t;
                l++;
                r--;
            }
        }
    public void rotate(int[] nums, int k) {
        k=k%nums.length;
        int n=nums.length;
        reverse(nums,0,n-1);
        reverse(nums,0,k-1);
        reverse(nums,k,n-1);
        
        System.out.println(Arrays.toString(nums));

        
    }
}
