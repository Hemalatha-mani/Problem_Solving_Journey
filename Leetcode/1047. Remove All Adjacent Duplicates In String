1047. Remove All Adjacent Duplicates In String

class Solution {
    public String removeDuplicates(String s) {
        Stack<Character> st=new Stack<>();
        for(char ch:s.toCharArray()){
            
            if(!st.isEmpty() &&ch==st.peek()){
                st.pop();
            }
            else{
                st.push(ch);
            }
        }
        String ans="";
        for(int i=0;i<st.size();i++){
            ans=ans+st.get(i);
        }
        return ans;
        
    }
}
