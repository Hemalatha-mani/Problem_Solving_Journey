496. Next Greater Element I

class Solution {
    public int[] nextGreaterElement(int[] n1, int[] n2) {
        int ans[]=new int[n1.length];
		for(int i=0;i<n1.length;i++) {
			for(int j=0;j<n2.length;j++) {
				if(n1[i]==n2[j]) {
					if(j==n2.length-1) {
						ans[i]=-1;
						break;
					}
					for(int k=j+1;k<n2.length;k++) {
						if(n2[k]>n2[j]) {
							ans[i]=n2[k];
							break;
							
						}
						else {
							ans[i]=-1;
						}
						
					}
				}
				
			}
		}
        return ans;
    }
}
