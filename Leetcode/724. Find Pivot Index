724. Find Pivot Index

class Solution {
    public int pivotIndex(int[] nums) {
        int total=0;
        int left=0;
        for(int n:nums){
            total=total+n;
        }
        for(int i=0;i<nums.length;i++){
            if(left==total-left-nums[i]){
                return i;
            //left=left+nums[i];
            }
            left=left+nums[i];
        }
        return -1;
        
    }
}
