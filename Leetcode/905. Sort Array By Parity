905. Sort Array By Parity

class Solution {
    public int[] sortArrayByParity(int[] nums) {
        ArrayList<Integer> a=new ArrayList<>();
        ArrayList<Integer> b=new ArrayList<>();
        for(int n:nums){
            if(n%2==0){
                b.add(n);
            }
            else{
                a.add(n);
            }
        }
        int ans[]=new int[nums.length];
        int j=0;
        for(int i=0;i<b.size();i++){
            ans[j++]=b.get(i);
        }
        for(int i=0;i<a.size();i++){
            ans[j++]=a.get(i);
        }
        return ans;

        
    }
}
