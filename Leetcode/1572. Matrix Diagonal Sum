1572. Matrix Diagonal Sum

class Solution {
    public int diagonalSum(int[][] mat) {
        int r=mat.length;
        int c=mat[0].length;
        int sum=0;
        for(int i=0;i<r;i++){
            sum=sum+mat[i][i];
            sum=sum+mat[i][r-1-i];
            
        }
        if(r%2==1){
            sum=sum-mat[r/2][r/2];
        }
            
        
        return sum;
    }
}
