152. Maximum Product Subarray

class Solution {
    public int maxProduct(int[] nums) {
        int pre=1;
        int suf=1;
        int ans=Integer.MIN_VALUE;
        int n=nums.length;
        for(int i=0;i<nums.length;i++){
            pre=pre*nums[i];
            suf=suf*nums[n-1-i];
            ans=Math.max(ans,Math.max(pre,suf));
            if(pre==0){
                pre=1;
            }
            if(suf==0){
                suf=1;
            }
        }
        return ans;
        
    }
}
